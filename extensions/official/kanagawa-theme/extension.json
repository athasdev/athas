        "function": "#7e9cd8",
        "keyword": "#957fb8",
        "null": "#ffa066",
        "number": "#d27e99",
        "operator": "#c0a36e",
        "property": "#e6c384",
        "punctuation": "#9cabca",
        "regex": "#ff5d62",
        "string": "#98bb6c",
        "tag": "#e46876",
        "type": "#7aa89f",
        "variable": "#dcd7ba"
