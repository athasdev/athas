{
  "$schema": "https://athas.dev/schemas/extension.json",
  "id": "athas.theme.kanagawa",
  "name": "kanagawa",
  "displayName": "Kanagawa",
  "description": "Dark colours inspired by Katsushika Hokusai's The Great Wave off Kanagawa. Ported from Kanagawa by rebelot, MIT.",
  "version": "1.0.0",
  "publisher": "Athas",
  "categories": [
    "Theme"
  ],
  "activationEvents": [
    "onTheme:kanagawa-wave"
  ],
  "themes": [
    {
      "id": "kanagawa-wave",
