{
  "name": "athas",
  "version": "0.15.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "check": "bash scripts/check.sh",
    "check:frontend": "bash scripts/check/frontend.sh",
    "check:services": "bun scripts/check/service-config.ts",
    "check:design": "bun scripts/check/design-system.ts",
    "services:check": "bun run check:services",
    "test:rust": "cargo test --workspace --no-fail-fast",
    "test:rust:coverage": "bash scripts/check/rust-coverage.sh",
    "lint": "vp lint .",
    "fix": "vp check --fix",
    "format": "vp fmt --write .",
    "check:rust": "bash scripts/check/rust.sh",
    "bindings": "bun scripts/generate-bindings.ts",
    "bindings:check": "bun scripts/generate-bindings.ts --check",
    "reset:workspace": "bun scripts/reset-workspace.ts",
    "postinstall": "bun scripts/postinstall.ts",
    "prepare": "vp config --no-agent",
    "commitlint": "commitlint",
    "setup": "bun scripts/setup.ts",
    "dev": "bun scripts/dev.ts",
    "cli": "bun scripts/cli.ts",
    "dev:stable": "tauri dev",
    "build:stable": "tauri build",
    "build:linux": "tauri build --bundles deb,rpm,appimage --no-sign",
    "build:linux:deb": "tauri build --bundles deb --no-sign",
    "build:linux:rpm": "tauri build --bundles rpm --no-sign",
    "build:linux:appimage": "tauri build --bundles appimage --no-sign",
    "build:linux:tarball": "tauri build --no-bundle && bash scripts/release/package-linux-tarball.sh $(uname -m) release-dist",
    "build:linux:flatpak": "bun run build:linux:tarball && bash scripts/release/packaging/linux/flatpak.sh $(uname -m) release-dist",
    "build:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "smoke:macos": "bun scripts/smoke-app.ts --platform macos",
    "smoke:linux": "bun scripts/smoke-app.ts --platform linux",
    "smoke:windows": "bun scripts/smoke-app.ts --platform windows",
    "e2e:build": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "e2e:build:windows": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json --config src-tauri/tauri.e2e.windows.conf.json",
    "e2e": "bun e2e/run.ts",
    "pre-commit": "bun scripts/hooks/pre-commit.ts",
    "release:check": "bun scripts/release/pre-release-check.ts",
    "release:verify": "bun scripts/release/release-assets.mjs verify --repo athasdev/athas",
    "release:repair-plan": "bun scripts/release/release-assets.mjs repair-plan --repo athasdev/athas",
    "release": "bun scripts/release.ts patch",
    "release:patch": "bun scripts/release.ts patch",
    "release:minor": "bun scripts/release.ts minor",
    "release:major": "bun scripts/release.ts major",
    "extensions:clean": "bun extensions/tooling/clean-cdn-output.ts",
    "extensions:serve": "bun extensions/tooling/serve-cdn.ts",
    "extensions:stage": "bun extensions/tooling/stage-cdn-assets.ts",
    "extensions:package": "bun extensions/tooling/package-extensions.ts",
    "extensions:package:databases": "bun extensions/tooling/package-database-sidecars.ts",
    "extensions:catalog": "bun extensions/tooling/build-extensions-index.ts && bun extensions/tooling/generate-manifests.ts",
    "extensions:prepare": "bun run extensions:clean && bun run extensions:package && bun run extensions:stage && bun run extensions:catalog",
    "extensions:validate": "bun extensions/tooling/validate.ts",
    "extensions:validate:agents": "bun extensions/tooling/validate.ts --verify-agent-registry",
    "extensions:index:check": "bun extensions/tooling/build-extensions-index.ts --check",
    "extensions:verify-cdn": "bun extensions/tooling/verify-installable-packages.ts",
    "extensions:deploy": "bun extensions/tooling/deploy-extensions-cdn.ts"
  },
