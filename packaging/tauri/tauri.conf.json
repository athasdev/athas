{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athas",
  "mainBinaryName": "athas",
  "version": "0.0.0",
  "identifier": "com.code.athas",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "publisher": "athasdev",
    "copyright": "Copyright © 2026 Athas",
    "homepage": "https://athas.dev",
    "category": "DeveloperTool",
    "shortDescription": "Lightweight code editor with Git, a terminal and AI agents",
    "longDescription": "Athas is a lightweight, open-source code editor for macOS, Windows and Linux. It has Git, an integrated terminal, a database viewer and coding agents built in.",
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ],
    "linux": {
      "appimage": { "bundleMediaFramework": false },
      "deb": {
        "desktopTemplate": "../linux/athas.desktop",
        "depends": ["libxkbcommon0", "libxkbcommon-x11-0", "libvulkan1", "libwayland-client0", "libfontconfig1", "libssl3"],
        "recommends": ["xdg-desktop-portal", "zenity"]
      },
      "rpm": {
        "desktopTemplate": "../linux/athas.desktop",
        "depends": ["libxkbcommon", "libxkbcommon-x11", "vulkan-loader", "libwayland-client", "fontconfig"],
        "recommends": ["xdg-desktop-portal", "zenity"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://athas.dev/api/update/stable"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNDk0QjI4NkVDNDQwRUUKUldUdVFNUnVLRXRKdXV2elJZL3RsOWkvRDJueUwvQjh1UzdMbFBHZmZjV01Ec3lXZ1hFY3V6RkYK"
    }
  }
}
