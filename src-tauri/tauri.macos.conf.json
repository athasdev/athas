{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Athas",
        "width": 1200,
        "height": 800,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        },
        "hiddenTitle": true,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 400,
        "minHeight": 400,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "markdown",
          "json",
          "jsonc",
          "yaml",
          "yml",
          "toml",
          "xml",
          "c",
          "h",
          "m",
          "mm",
          "cc",
          "cpp",
          "hpp",
          "swift",
          "rs",
          "go",
          "zig",
          "py",
          "rb",
          "php",
          "js",
          "jsx",
          "ts",
          "tsx",
          "css",
          "scss",
          "html",
          "htm",
          "sh",
          "zsh",
          "bash",
          "fish",
          "sql",
          "vue",
          "svelte"
        ],
        "contentTypes": ["public.plain-text", "public.source-code", "public.script"],
        "name": "Text and Source Code",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
